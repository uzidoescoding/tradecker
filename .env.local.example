# Copy this file to `.env.local` - that is the one Next.js actually loads.
#
#   cp .env.local.example .env.local
#
# Optional. Without a key the AI panels say so plainly and every other part of
# the site, including the consensus scoring, works unchanged.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Any open-weight model Groq serves. Default: openai/gpt-oss-120b
# Groq retires models often; list live ones at https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
